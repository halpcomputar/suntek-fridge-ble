{
  "config": {
    "flow_title": "{name}",
    "step": {
      "confirm": {
        "description": "Add the fridge {name}?\n\nHome Assistant will hold a Bluetooth connection to it. The fridge accepts only one connection at a time, so the BougeRV app will not be able to connect while Home Assistant is connected."
      },
      "user": {
        "data": {
          "address": "Device"
        }
      }
    },
    "abort": {
      "already_configured": "This fridge is already configured",
      "no_devices_found": "No compatible fridge found. Make sure it is powered on, in range, and that the vendor app is closed.",
      "not_supported": "This device is not a supported SUNTEK fridge"
    }
  },
  "entity": {
    "climate": {
      "zone1": {
        "name": "Zone 1",
        "state_attributes": {
          "preset_mode": {
            "state": {
              "eco": "Eco",
              "max": "Max"
            }
          }
        }
      },
      "zone2": {
        "name": "Zone 2",
        "state_attributes": {
          "preset_mode": {
            "state": {
              "eco": "Eco",
              "max": "Max"
            }
          }
        }
      }
    },
    "select": {
      "battery_protection": {
        "name": "Battery protection",
        "state": {
          "low": "Low (9.6-10.9 V)",
          "medium": "Medium (10.1-11.4 V)",
          "high": "High (11.1-12.4 V)"
        }
      },
      "display_unit": {
        "name": "Panel display unit",
        "state": {
          "celsius": "Celsius",
          "fahrenheit": "Fahrenheit"
        }
      }
    },
    "sensor": {
      "zone1_temperature": {
        "name": "Zone 1 temperature"
      },
      "zone2_temperature": {
        "name": "Zone 2 temperature"
      },
      "voltage": {
        "name": "Input voltage"
      }
    },
    "switch": {
      "power": {
        "name": "Power"
      }
    }
  }
}
